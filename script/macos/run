#!/bin/bash
#
# macOS-specific implementation of `./script/run`. Runs Cute as a real 'app'
# instead of a bare executable, so macOS can treat it like a real signed app
# (custom URL schemes, user notifications, etc.).
#
# This script ONLY supports the 'cute' application.
# It is invoked by `./script/run`, which handles cross-platform setup.
# The following env vars are expected to be set by the caller:
#   WARP_BIN_NAME  — must be "cute"
#   WARP_CHANNEL   — must be "oss"
#   FEATURES       — comma-separated cargo features (already normalized)
# Must be called from the root directory of the cute repo.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "${REPO_ROOT}"

: "${WARP_BIN_NAME:?WARP_BIN_NAME must be set (invoke via ./script/run)}"
: "${WARP_CHANNEL:?WARP_CHANNEL must be set (invoke via ./script/run)}"
: "${FEATURES:?FEATURES must be set (invoke via ./script/run)}"

# Validate that we're running cute
if [ "$WARP_BIN_NAME" != "cute" ]; then
    echo "Error: This project only supports 'cute' application. WARP_BIN_NAME=$WARP_BIN_NAME is not supported." >&2
    exit 1
fi

# Cute application paths
WARP_APP_PATH="target/debug/bundle/osx/Cute.app"
WARP_SCHEME_NAME="cute"
DONT_OPEN=false
# Launches the binary with "open", meaning the Warp process is
# launched by the MacOS application launcher instead of a shell session.
# Note that since Warp isn't launched as a child process, using ctrl+c
# won't kill the app (but will kill the tail process displaying output).
# tl;dr better simulates running Warp Dev/Stable
OPEN_WITH_LAUNCHD=false

# Arguments to pass directly Warp (specified after --)
# This is not supported when opening with launchd, as passing CLI arguments to
# an application doesn't make sense.
WARP_ARGS=()

# Export this variable so it can be referenced by app/build.rs later when
# running `cargo bundle`.
export FRAMEWORK_OVERRIDE="dev"

PARAMS=""
while (( "$#" )); do
  case "$1" in
    --)
      shift
      WARP_ARGS=("$@")
      break
      ;;
    --dont-open)
      DONT_OPEN=true
      shift
      ;;
    --release)
      echo "Detected release build, pointing at release bundle under target/release/bundle"
      WARP_APP_PATH="target/release/bundle/osx/Cute.app"
      PARAMS="$PARAMS $1"
      shift
      ;;
    --profile)
      PROFILE="$2"
      shift 2
      WARP_APP_PATH="target/${PROFILE}/bundle/osx/Cute.app"
      PARAMS="$PARAMS --profile $PROFILE"
      ;;
    --open_with_launchd)
      OPEN_WITH_LAUNCHD=true
      shift
      ;;
    --generate-schema)
      GENERATE_SCHEMA=true
      shift
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done

rm -rf "$WARP_APP_PATH"

pushd app > /dev/null
echo "Bundling app (bin: $WARP_BIN_NAME)..."
cargo bundle --bin "$WARP_BIN_NAME" --features "$FEATURES" $PARAMS
echo "Successfully bundled..."
popd > /dev/null

if [[ ",$FEATURES," =~ ",cocoa_sentry," ]]; then
  echo "Copying Sentry framework into app bundle..."
  SENTRY_FRAMEWORK="app/frameworks/dev/Sentry-Dynamic-WithARM64e.xcframework/macos-arm64_arm64e_x86_64/Sentry.framework"
  mkdir -p "$WARP_APP_PATH/Contents/Frameworks"
  cp -a "$SENTRY_FRAMEWORK" "$WARP_APP_PATH/Contents/Frameworks/"
fi
echo "Adding rpath to support mac frameworks (e.g. Sentry)"
install_name_tool -add_rpath "@executable_path/../Frameworks" "$WARP_APP_PATH/Contents/MacOS/$WARP_BIN_NAME"

export WARP_SCHEME_NAME
export WARP_PLIST_PATH="$WARP_APP_PATH/Contents/Info.plist"
./script/update_plist

echo "Preparing bundled resources..."
if [ "${GENERATE_SCHEMA:-false}" != "true" ]; then
  export SKIP_SETTINGS_SCHEMA=1
fi
NO_LICENSES=1 "${REPO_ROOT}/script/prepare_bundled_resources" "$WARP_APP_PATH/Contents/Resources" "$WARP_CHANNEL"

# shellcheck source=script/cute_icon.sh
source "${REPO_ROOT}/script/cute_icon.sh"
apply_cute_app_icon "$WARP_APP_PATH"

# 也更新 dmg 目录中的应用图标（如果有）
WARP_DMG_APP_PATH="${WARP_APP_PATH/osx/dmg}"
WARP_DMG_PATH="${WARP_APP_PATH/osx/dmg}"
WARP_DMG_PATH="${WARP_DMG_PATH%.app}.dmg"
if [[ -d "$WARP_DMG_APP_PATH" && "$WARP_DMG_APP_PATH" != "$WARP_APP_PATH" ]]; then
    echo "Updating DMG app bundle icon..."
    # 复制已编译的图标到 dmg 应用
    cp -R "$WARP_APP_PATH/Contents/Resources/AppIcon.icns" "$WARP_DMG_APP_PATH/Contents/Resources/" 2>/dev/null || true
    cp -R "$WARP_APP_PATH/Contents/Resources/Assets.car" "$WARP_DMG_APP_PATH/Contents/Resources/" 2>/dev/null || true
    # 更新 Info.plist 的图标引用
    plutil -replace CFBundleIconFile -string "AppIcon" "$WARP_DMG_APP_PATH/Contents/Info.plist" 2>/dev/null || true
    plutil -insert CFBundleIconName -string "AppIcon" "$WARP_DMG_APP_PATH/Contents/Info.plist" 2>/dev/null || \
        plutil -replace CFBundleIconName -string "AppIcon" "$WARP_DMG_APP_PATH/Contents/Info.plist" 2>/dev/null || true
    # 重新创建 DMG（因为 cargo bundle 创建的 DMG 使用的是旧图标）
    if [[ -f "$WARP_DMG_PATH" ]]; then
        echo "Recreating DMG with updated icon..."
        rm -f "$WARP_DMG_PATH"
        hdiutil create -volname "Cute" -srcfolder "$WARP_DMG_APP_PATH" -ov -format UDZO "$WARP_DMG_PATH" 2>&1 | grep -E "(created|error)" || true
    fi
fi

if [[ ",$FEATURES," =~ ",heap_usage_tracking," ]]; then
  echo "Bundling pprof..."
  HELPERS_DIR="$WARP_APP_PATH/Contents/Helpers"
  "${REPO_ROOT}/script/prepare_bundled_pprof" "$HELPERS_DIR"
fi

echo "Codesigning app..."
SIGNING_CERT="$(security find-identity -p codesigning -v | grep "Apple Development" | awk '{print $2}' | head -1)"
codesign --force --deep --options runtime --sign "${SIGNING_CERT:--}" "$WARP_APP_PATH" --entitlements script/Debug-Entitlements.plist

if [ "$DONT_OPEN" = false ] ; then
    # 默认使用 open 命令打开应用，确保正确注册到 macOS 并显示在 Dock
    echo "Opening app with 'open' command (will appear in Dock)"
    PATH="" /usr/bin/open "./$WARP_APP_PATH"
    if [ "$WARP_CHANNEL" = "local" ]; then
        LOG_FILE=~/Library/Logs/warp_local.log
    elif [ "$WARP_CHANNEL" = "oss" ]; then
        LOG_FILE=~/Library/Logs/cute.log
    else
        echo "Warning: unrecognized WARP_CHANNEL '$WARP_CHANNEL', defaulting to OSS log path" >&2
        LOG_FILE=~/Library/Logs/cute.log
    fi
    echo "Following logs (Ctrl+C to stop)..."
    tail -F "$LOG_FILE"
fi
